<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NOTE: LogiPluginTool 6.1.4 scaffolds net8.0, but the installed
         PluginApi.dll (6.4.0.3079) is built against .NET 10. Compiling against
         it from net8.0 fails with CS1705. Must match the Plugin Service runtime. -->
    <!-- Plain net10.0, NOT net10.0-windows. `logiplugintool verify` inspects this
         assembly with a metadata resolver that cannot load desktop framework
         assemblies, so a reference to System.Windows.Forms here fails packaging
         and blocks Marketplace submission. The settings UI therefore lives in a
         separate executable (MxHapticsSettings) bundled in the same package. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Loupedeck.MxHapticsPlugin</RootNamespace>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- No debug symbols in a Release package: nobody downloading the plugin
         needs them, and they are a third of the payload. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!-- SharpHook ships a native uiohook binary per runtime identifier. Without a
         RID pinned, ALL of them are copied to runtimes/*/native/ and the Logi
         Plugin Service's assembly resolver picks the first match it finds -
         observed loading win-arm64/native/uiohook.dll on this x64 machine, which
         silently produced a hook that never delivered events.
         Pinning the RID makes only the correct native binary ship. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- macOS builds are driven by passing a RID: `dotnet build -r osx-arm64`.
         They differ enough from Windows to need their own switch: no settings
         application (it is WinForms), no native binary of ours at all, and a
         separate output tree so a cross-build never clobbers the Windows one. -->
    <IsMacBuild>false</IsMacBuild>
    <IsMacBuild Condition="$(RuntimeIdentifier.StartsWith('osx'))">true</IsMacBuild>

    <!-- The .link file and reload command only make sense when building FOR the
         machine you are building ON. Cross-building macOS from Windows must not
         point the local Plugin Service at a macOS build. -->
    <IsDevLoopBuild>false</IsDevLoopBuild>
    <IsDevLoopBuild Condition="'$(OS)' == 'Windows_NT' and '$(IsMacBuild)' != 'true'">true</IsDevLoopBuild>
    <IsDevLoopBuild Condition="'$(OS)' != 'Windows_NT' and '$(IsMacBuild)' == 'true'">true</IsDevLoopBuild>

    <!-- Keep the output at bin/ rather than bin/win-x64/. Setting a RID otherwise
         appends it to the output path, which would shift everything one level
         and break 'pluginFolderWin: bin' in LoupedeckPackage.yaml. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <PluginApiDir Condition="$(OS) == 'Windows_NT'">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginApiDir Condition="$(OS) != 'Windows_NT'">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>

    <PluginDir Condition="$(OS) == 'Windows_NT'">$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>
    <PluginDir Condition="$(OS) != 'Windows_NT'">~/Library/Application\ Support/Logi/LogiPluginService/Plugins/</PluginDir>

    <BaseOutputPath Condition="'$(IsMacBuild)' != 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\'))</BaseOutputPath>
    <BaseOutputPath Condition="'$(IsMacBuild)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin-mac\'))</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\bin\</OutputPath>

    <PluginShortName>MxHaptics</PluginShortName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>

      <!-- Compile against it, but do not ship it. The Logi Plugin Service loads
           the plugin into its own process and already provides PluginApi.dll and
           its dependencies (SkiaSharp, YamlDotNet, Newtonsoft.Json, and others).
           Bundling our own copies would put a second, possibly older, set of
           those assemblies in the package and invite version conflicts against
           whatever the installed Options+ actually has. -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpHook" Version="7.1.3" />
  </ItemGroup>

  <!-- Build the settings application and copy it in beside the plugin assembly,
       so the package contains everything and the user installs one thing. It is
       a separate project purely so THIS assembly stays free of desktop framework
       references, which `logiplugintool verify` cannot resolve. -->
  <Target Name="BuildSettingsApp" BeforeTargets="PostBuildEvent" Condition="'$(IsMacBuild)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\..\MxHapticsSettings\MxHapticsSettings.csproj&quot; -c $(Configuration) --nologo -v quiet" />
  </Target>

  <!-- macOS gets its own settings application. Windows keeps the WinForms one,
       which works and ships - there is nothing for Windows to gain from a
       rewrite, so the two are deliberately separate rather than unified for its
       own sake. Both compile in the same HapticEvents.cs and Waveforms.cs, so the
       event catalogue cannot drift between them. -->
  <Target Name="BuildMacSettingsApp" BeforeTargets="PostBuildEvent" Condition="'$(IsMacBuild)' == 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\..\MxHapticsSettingsMac\MxHapticsSettingsMac.csproj&quot; -c $(Configuration) --nologo -v quiet" />
  </Target>

  <Target Name="CopyMacSettingsApp" AfterTargets="PostBuildEvent" Condition="'$(IsMacBuild)' == 'true'">
    <ItemGroup>
      <MacSettingsAppFiles Include="$(MSBuildThisFileDirectory)..\..\MxHapticsSettingsMac\bin\$(Configuration)\**\*.*"
                           Exclude="$(MSBuildThisFileDirectory)..\..\MxHapticsSettingsMac\bin\$(Configuration)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(MacSettingsAppFiles)" DestinationFolder="$(OutputPath)%(RecursiveDir)" />
    <Message Text="🍎 macOS settings application copied into plugin output" Importance="High" />
  </Target>

  <Target Name="CopySettingsApp" AfterTargets="PostBuildEvent" Condition="'$(IsMacBuild)' != 'true'">
    <ItemGroup>
      <SettingsAppFiles Include="$(MSBuildThisFileDirectory)..\..\MxHapticsSettings\bin\$(Configuration)\**\*.*"
                        Exclude="$(MSBuildThisFileDirectory)..\..\MxHapticsSettings\bin\$(Configuration)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(SettingsAppFiles)" DestinationFolder="$(OutputPath)%(RecursiveDir)" />
    <Message Text="🪟 Settings application copied into plugin output" Importance="High" />
  </Target>

  <Target Name="CopyPackage" AfterTargets="PostBuildEvent">
    <Message Text="📦 Copying package files..." Importance="High" />
    <ItemGroup>
      <PackageFiles Include="package\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(OutputPath)..\%(RecursiveDir)" />
    <Message Text="✅ Package files copied to $(OutputPath)..\" Importance="High" />
  </Target>

  <!-- SharpHook copies its native binary for whatever RID is pinned. On macOS we
       never load it - the Plugin Service's hardened runtime would refuse it - so
       shipping it is dead weight and invites the reasonable question of why a
       plugin carries a native library it never opens. -->
  <Target Name="DropUnusedMacNative" AfterTargets="Build" Condition="'$(IsMacBuild)' == 'true'">
    <ItemGroup>
      <UnusedNative Include="$(OutputPath)libuiohook.dylib" />
      <UnusedNative Include="$(OutputPath)runtimes\**\*.dylib" />
    </ItemGroup>
    <Delete Files="@(UnusedNative)" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(IsDevLoopBuild)' == 'true'">
    <Exec Condition="$(OS) == 'Windows_NT'" Command="echo $(BaseOutputPath)$(Configuration)\ &gt; &quot;$(PluginDir)$(ProjectName).link&quot;" />
    <Exec Condition="$(OS) != 'Windows_NT'" Command="echo $(BaseOutputPath)$(Configuration)\ &gt; $(PluginDir)$(ProjectName).link" />
    <Message Text="🔨 Created plugin link at: $(PluginDir)$(ProjectName).link" Importance="High" />

    <Message Text="🔄 Sending plugin reload command for $(PluginShortName) to Logi Plugin Service" Importance="High" />
    <Exec Condition="$(OS) == 'Windows_NT'" Command="start loupedeck:plugin/$(PluginShortName)/reload" ContinueOnError="true" />
    <Exec Condition="$(OS) != 'Windows_NT'" Command="open loupedeck:plugin/$(PluginShortName)/reload" ContinueOnError="true" />
    <Message Condition="'$(MSBuildLastTaskResult)' == 'false'" Text="❌ Couldn't reload the plugin, please restart the Logi Plugin Service manually" Importance="High" />
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Message Text="🧹 Cleaning up plugin link file and output directories..." Importance="High" />

    <Delete Condition="$(OS) == 'Windows_NT'" Files="$(PluginDir)$(ProjectName).link" />
    <Exec Condition="$(OS) != 'Windows_NT'" Command="rm -f $(PluginDir)$(ProjectName).link" />

    <RemoveDir Directories="$(OutputPath)..\" />

    <Message Text="🧼 Plugin link file and output directories have been cleaned!" Importance="High" />
  </Target>

</Project>
