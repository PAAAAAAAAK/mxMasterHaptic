<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MxHapticsSettings</RootNamespace>
    <AssemblyName>MxHapticsSettings</AssemblyName>
    <LangVersion>latest</LangVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Ships inside the plugin package next to the plugin assembly. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The event catalogue and waveform list are COMPILED INTO BOTH the plugin
         and this application, rather than sent over the pipe. Both sides then
         share one definition of what events exist and what each is called, and
         only the values (enabled, chosen waveform) ever cross the process
         boundary. Duplicating those lists instead would let them drift silently. -->
    <Compile Include="..\MxHapticsPlugin\src\Config\HapticEvents.cs" Link="Shared\HapticEvents.cs" />
    <Compile Include="..\MxHapticsPlugin\src\Haptics\Waveforms.cs" Link="Shared\Waveforms.cs" />
  </ItemGroup>

</Project>
